extends ../layouts/base.pug

block content
    section(id="home", class="px-5 py-10 sm:px-8 sm:py-16 lg:px-12 lg:py-20")
        div(class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-14")
            div(class="lg:col-span-5 lg:py-8")
                p(class="mb-5 text-xs font-medium uppercase tracking-[0.24em] text-[#78846F]") Handmade in Oxfordshire
                h1(class="font-heading max-w-xl text-5xl leading-[0.98] tracking-tight text-[#414A3D] sm:text-6xl lg:text-7xl") Beautifully Made Curtains & Blinds
                p(class="mt-6 max-w-lg text-base leading-7 text-[#625C54] sm:text-lg") Handmade, made-to-measure curtains and blinds, thoughtfully created for your home in Oxfordshire.
                div(class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center")
                    a(class="inline-flex items-center justify-center bg-[#414A3D] px-6 py-3.5 text-sm text-[#F7F4EE] transition-colors hover:bg-[#30382D]", href="/contact/") Get in Touch
                    a(class="inline-flex items-center gap-2 py-3 text-sm text-[#414A3D] underline decoration-[#A6A08F] underline-offset-4 transition-colors hover:text-[#78846F]", href="#services") Explore Our Services
                div(class="mt-12 border-t border-[#D9D1C3] pt-6")
                    p(class="text-xs font-medium uppercase tracking-[0.2em] text-[#78846F]") A personal approach
                    p(class="mt-3 max-w-lg text-sm leading-6 text-[#625C54]") Annie offers individual attention from choosing fabrics through measuring and fitting, helping you find window furnishings that feel right at home.
            div(class="relative lg:col-span-7")
                div(class="absolute -bottom-4 -left-4 hidden h-32 w-32 border border-[#A6A08F]/70 md:block")
                img(class="relative h-[390px] w-full object-cover object-center sm:h-[520px] lg:h-[620px]", src="/images/home/patterned-sitting-room-curtain-960.webp", srcset="/images/home/patterned-sitting-room-curtain-480.webp 480w, /images/home/patterned-sitting-room-curtain-960.webp 960w, /images/home/patterned-sitting-room-curtain-1920.webp 1920w", sizes="(min-width: 1376px) 724px, (min-width: 1024px) calc(58.333333vw - 79.333333px), (min-width: 640px) calc(100vw - 64px), calc(100vw - 40px)", width="960", height="1440", style="object-position: 50% 0%", alt="Patterned pleated curtain beside a tall window and white shutters", loading="eager", fetchpriority="high")
                p(class="absolute bottom-4 right-4 bg-[#F7F4EE]/95 px-4 py-2 text-xs tracking-wide text-[#514B44] sm:bottom-6 sm:right-6") Soft furnishings, made for living
    section(id="services", class="bg-[#EEEAE1] px-5 py-16 sm:px-8 sm:py-20 lg:px-12 lg:py-24")
        div(class="mx-auto max-w-7xl")
            div(class="mb-10 flex flex-col gap-4 sm:mb-14 sm:flex-row sm:items-end sm:justify-between")
                div
                    p(class="text-xs font-medium uppercase tracking-[0.24em] text-[#78846F]") Made for your home
                    h2(class="font-heading mt-3 text-4xl leading-tight text-[#414A3D] sm:text-5xl") Considered from fabric to fit
                p(class="max-w-md text-sm leading-6 text-[#625C54]") Beautiful materials, careful making and the details that bring a room together.
            div(class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-10")
                article(id="curtains", class="lg:col-span-7")
                    a(class="group block", href="/contact/", aria-label="Enquire about bespoke curtains")
                        div(class="overflow-hidden")
                            img(class="h-[300px] w-full object-cover transition-transform duration-700 group-hover:scale-[1.02] sm:h-[420px]", src="/images/home/kitchen-curtain-pair-1280.webp", srcset="/images/home/kitchen-curtain-pair-640.webp 640w, /images/home/kitchen-curtain-pair-1280.webp 1280w, /images/home/kitchen-curtain-pair-1920.webp 1920w", sizes="(min-width: 1376px) 730px, (min-width: 1024px) max(625px, calc(58.333333vw - 72.666667px)), (min-width: 640px) max(625px, calc(100vw - 64px)), max(447px, calc(100vw - 40px))", width="1280", height="860", style="object-position: 50% 0%", alt="Pair of patterned curtains framing a kitchen window", loading="lazy", decoding="async")
                        div(class="mt-5 flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between")
                            h3(class="font-heading text-3xl text-[#414A3D]") Bespoke Curtains
                            span(class="text-sm text-[#625C54]") Made to measure, made by hand
                    p(class="mt-3 max-w-xl text-sm leading-6 text-[#625C54]") From the first fabric choice to the finished drape, each pair is made to suit your windows, your room and the way you live.
                    a(class="mt-4 inline-block text-sm text-[#414A3D] underline decoration-[#A6A08F] underline-offset-4", href="/category/curtain-headings/") Explore curtain headings
                article(id="blinds", class="lg:col-span-5 lg:mt-20")
                    a(class="group block", href="/contact/", aria-label="Enquire about made-to-measure blinds")
                        div(class="overflow-hidden")
                            img(class="h-[280px] w-full object-cover transition-transform duration-700 group-hover:scale-[1.02] sm:h-[350px]", src="/images/home/corner-roman-blinds-1280.webp", srcset="/images/home/corner-roman-blinds-640.webp 640w, /images/home/corner-roman-blinds-1280.webp 1280w, /images/home/corner-roman-blinds-1920.webp 1920w", sizes="(min-width: 1376px) 510px, (min-width: 1024px) max(467px, calc(41.666667vw - 63.333333px)), (min-width: 640px) calc(100vw - 64px), max(374px, calc(100vw - 40px))", width="1280", height="960", style="object-position: 50% 45%", alt="Checked Roman blinds on two corner windows", loading="lazy", decoding="async")
                        h3(class="font-heading mt-5 text-3xl text-[#414A3D]") Made-to-Measure Blinds
                    p(class="mt-3 text-sm leading-6 text-[#625C54]") Roman blinds and other considered solutions, made to bring softness, privacy and a pleasing finish to your windows.
                div(class="border-t border-[#CFC7B8] pt-8 lg:col-span-12 lg:mt-4 lg:grid lg:grid-cols-12 lg:gap-10")
                    div(class="lg:col-span-4")
                        p(class="text-xs font-medium uppercase tracking-[0.24em] text-[#78846F]") Made with care
                        h3(class="font-heading mt-3 text-3xl leading-tight text-[#414A3D]") The small details make a difference.
                    div(class="mt-4 lg:col-span-8 lg:mt-0 lg:grid lg:grid-cols-2 lg:gap-10")
                        p(class="text-sm leading-7 text-[#625C54]") Choosing a fabric is personal. Annie can help you consider texture, pattern and colour in the context of your room, then take careful measurements for a finish that feels considered.
                        div(id="curtain-headings", class="mt-5 border-l border-[#A6A08F] pl-5 lg:mt-0")
                            h4(class="font-heading text-2xl text-[#414A3D]") Curtain headings
                            p(class="mt-2 text-sm leading-6 text-[#625C54]") From a relaxed gathered look to a more tailored pleat, the heading shapes how curtains hang and how a room feels.
    section(id="work", class="px-5 py-16 sm:px-8 sm:py-20 lg:px-12 lg:py-24")
        div(class="mx-auto max-w-7xl")
            div(class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-12")
                div(class="lg:col-span-4")
                    p(class="text-xs font-medium uppercase tracking-[0.24em] text-[#78846F]") A selection
                    h2(class="font-heading mt-3 text-4xl leading-tight text-[#414A3D] sm:text-5xl") Our Work
                    p(class="mt-5 max-w-sm text-sm leading-7 text-[#625C54]") A glimpse of the possibilities, from softly tailored curtains to practical blinds and distinctive window solutions. Project photographs will be added here.
                    div(id="testimonials", class="mt-10 border-t border-[#D9D1C3] pt-7")
                        p(class="text-xs font-medium uppercase tracking-[0.2em] text-[#78846F]") Kind words
                        blockquote(class="mt-4 font-heading text-2xl leading-snug text-[#414A3D]") “Customer testimonial placeholder. This space will feature a genuine review with permission.”
                        p(class="mt-4 text-xs uppercase tracking-[0.16em] text-[#81796F]") Placeholder text
                div(class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:col-span-8 lg:grid-cols-12 lg:gap-5")
                    figure(class="lg:col-span-7")
                        img(class="h-[280px] w-full object-cover sm:h-[360px]", src="/images/home/sloping-window-curtains-960.webp", srcset="/images/home/sloping-window-curtains-640.webp 640w, /images/home/sloping-window-curtains-960.webp 960w, /images/home/sloping-window-curtains-1280.webp 1280w", sizes="(min-width: 1376px) 480px, (min-width: 1024px) 480px, (min-width: 640px) max(480px, calc(50vw - 40px)), max(374px, calc(100vw - 40px))", width="960", height="720", style="object-position: 50% 0%", alt="Closed curtains following the sloping top of a window", loading="lazy", decoding="async")
                        figcaption(class="mt-2 text-xs tracking-wide text-[#81796F]") Project image placeholder
                    figure(class="sm:mt-12 lg:col-span-5")
                        img(class="h-[240px] w-full object-cover sm:h-[300px]", src="/images/home/patterned-curtains-room-800.webp", srcset="/images/home/patterned-curtains-room-480.webp 480w, /images/home/patterned-curtains-room-800.webp 800w, /images/home/patterned-curtains-room-1280.webp 1280w", sizes="(min-width: 1376px) 338px, (min-width: 1024px) calc(27.777778vw - 44.444444px), (min-width: 640px) calc(50vw - 40px), calc(100vw - 40px)", width="800", height="1208", style="object-position: 50% 45%", alt="Patterned curtains beside a window, telescope and upholstered chairs", loading="lazy", decoding="async")
                        figcaption(class="mt-2 text-xs tracking-wide text-[#81796F]") Project image placeholder
                    div(class="mt-5 border-t border-[#D9D1C3] pt-6 sm:col-span-2 lg:col-span-12 lg:mt-2 lg:flex lg:items-start lg:justify-between lg:gap-10")
                        h3(class="font-heading text-3xl text-[#414A3D]") Rooted in Oxfordshire
                        p(class="mt-3 max-w-2xl text-sm leading-7 text-[#625C54] lg:mt-0") Based in Ascott-under-Wychwood, Annie works across Oxfordshire and neighbouring counties, bringing a personal, carefully considered service to homes in the area.
